SDKMANAGER_IMAGE=sdkmanager:latest
SDKM_LOGIN_TYPE=devzone
SDKM_DOCKER_NETWORK=host
SDKM_MEDIA_DIR=/media/timon
SDKM_DOWNLOADS_DIR=.sdkm/downloads
SDKM_TARGET_IMAGE_DIR=.sdkm/nvidia_sdk
SDKM_STAY_LOGGED_IN=true
SDKM_COLLECT_USAGE=disable
SDKM_ARCHIVED_VERSIONS=0
SDKM_AUTO=0

# Set these before running download-only or flash services.
JETPACK_VERSION=5.1.4
JETSON_TARGET=JETSON_AGX_XAVIER_TARGETS

# Optional when more than one Jetson is attached.
SDKM_USB_PORT=

# Extra raw sdkmanager CLI arguments for direct Compose runs.
SDKM_EXTRA_ARGS=