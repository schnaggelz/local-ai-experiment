# Host port exposed by Compose
OLLAMA_PORT=11434

# Ollama runtime defaults used by the container
OLLAMA_HOST=0.0.0.0
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KEEP_ALIVE=10m
OLLAMA_KV_CACHE_TYPE=q8_0
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_MAX_QUEUE=16
OLLAMA_MAX_VRAM=23552
OLLAMA_NUM_PARALLEL=1
OLLAMA_CONTEXT_LENGTH=65536
