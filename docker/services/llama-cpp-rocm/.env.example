MODEL=/models/your-model.gguf
MODELS_DIR=./models

# ROCm runtime
HSA_OVERRIDE_GFX_VERSION=11.0.0
HIP_VISIBLE_DEVICES=all

# Core server
LLAMA_HOST=0.0.0.0
LLAMA_PORT=8080
LLAMA_CTX_SIZE=8192
LLAMA_PREDICT=-1
LLAMA_THREADS=-1
LLAMA_THREADS_BATCH=-1

# Batching
LLAMA_BATCH_SIZE=2048
LLAMA_UBATCH_SIZE=512
LLAMA_PARALLEL=1

# GPU and MoE placement
LLAMA_GPU_LAYERS=99
LLAMA_MAIN_GPU=0
LLAMA_CPU_MOE=0
LLAMA_N_CPU_MOE=16

# Sometimes used
LLAMA_THREADS_HTTP=-1
LLAMA_TIMEOUT=600
LLAMA_MLOCK=0
LLAMA_NO_MMAP=0
LLAMA_LOG_FORMAT=json
LLAMA_API_KEY=
LLAMA_SYSTEM_PROMPT_FILE=
LLAMA_FLASH_ATTN=0
LLAMA_METRICS=0
LLAMA_VERBOSE=0

# Escape hatch for flags not mapped above
LLAMA_EXTRA_ARGS=